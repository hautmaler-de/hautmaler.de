{
  "name": "hautmaler-de",
  "version": "1.0.0",
  "private": true,
  "description": "Quality and release-readiness checks for the static Die Hautmaler website.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs 4173",
    "build:site": "node scripts/build-site.mjs",
    "images:generate": "node scripts/generate-images.mjs",
    "check:html": "html-validate --config htmlvalidate.config.mjs \"*.html\"",
    "check:js": "node scripts/check-javascript.mjs",
    "check:static": "node scripts/check-static.mjs",
    "check:external": "node scripts/check-external-links.mjs",
    "check:media": "node scripts/check-media.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "check:lighthouse": "node scripts/run-lighthouse.mjs",
    "check:dependencies": "npm audit --audit-level=moderate",
    "release:check": "node scripts/release-readiness.mjs",
    "test": "npm run release:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "exifr": "7.1.3",
    "html-validate": "11.6.2",
    "lighthouse": "13.4.1",
    "sharp": "0.35.3",
    "yaml": "2.9.0"
  }
}
